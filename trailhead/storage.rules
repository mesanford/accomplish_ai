rules_version = '2';

// Cloud Storage holds only troop website images.
//   sites/{t}/draft/*   the leader's uploads while editing: that troop's leaders only, images up to 8 MB.
//   sites/{t}/public/*  copies made by the publish_site function: anyone may read, no client writes.
// Everything else is closed. Leader checks read the troop's access record from Firestore.
service firebase.storage {
  match /b/{bucket}/o {
    function accessPath(t) {
      return /databases/(default)/documents/troops/$(t)/access/$(request.auth.uid);
    }
    function isLeader(t) {
      return request.auth != null
        && firestore.exists(accessPath(t))
        && firestore.get(accessPath(t)).data.roles.hasAny(['leader', 'advancement']);
    }
    function isImageUpload() {
      return request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|gif|webp)');
    }

    match /sites/{t}/draft/{file} {
      allow read, delete: if isLeader(t);
      allow create, update: if isLeader(t) && isImageUpload();
    }
    match /sites/{t}/public/{file} {
      allow read: if true;
      allow write: if false;
    }
    match /{everything=**} {
      allow read, write: if false;
    }
  }
}
