# Settings for the production project scout-app-prod-d6a66. Firebase loads .env.<project-id> on deploy.
TRAILHEAD_STORAGE_BUCKET=scout-app-prod-d6a66.firebasestorage.app
ANTHROPIC_MODEL=claude-sonnet-5-5
# The production API key is not scoped to a workspace, so every request names the Trailhead workspace.
ANTHROPIC_WORKSPACE_ID=wrkspc_01QiQwSLTjh1L6brBfPbaWNc

# Email through Resend (its key is the RESEND_API_KEY secret). EMAIL_MODE=log only logs a count; send really sends.
# onboarding@resend.dev is Resend's test sender: it delivers only to the Resend account owner and refuses other
# recipients. Replace it with an address on a verified domain before real families get email.
EMAIL_MODE=send
EMAIL_FROM="Forthright <onboarding@resend.dev>"
APP_URL=https://forthrightapp.com

# A troop's own domain (see DEPLOY.md, "Troop domains"). DOMAINS_MODE: off (default), log (fake, no API calls) or live.
# TRAILHEAD_TROOPS_SITE is the dedicated Hosting site id that troops' domains attach to.
# DOMAINS_MODE=live
# TRAILHEAD_TROOPS_SITE=forthright-troops
