# Settings for the staging project scout-app-d2282. Firebase loads .env.<project-id> on deploy.
TRAILHEAD_STORAGE_BUCKET=scout-app-d2282.firebasestorage.app

# Staging uses the practice drafts, never the Anthropic API. Its ANTHROPIC_API_KEY secret is a stand-in.
TRAILHEAD_FAKE_LLM=1

# Email through Resend (its key is the RESEND_API_KEY secret). EMAIL_MODE=log only logs a count; send really sends.
# onboarding@resend.dev is Resend's test sender: it delivers only to the Resend account owner and refuses other
# recipients. Replace it with an address on a verified domain before real families get email.
EMAIL_MODE=log
EMAIL_FROM="Forthright <onboarding@resend.dev>"
APP_URL=https://scout-app-d2282.web.app
