# Web app config for a real Firebase project (Project settings > Your apps). Not needed for local emulators.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
# Push notifications. Both are optional; with no key the "Notify me on this device" option is hidden and nothing is sent.
# Sender id: Project settings > Cloud Messaging > Sender ID. Key: Project settings > Cloud Messaging > Web Push
# certificates > Generate key pair (the "Key pair" value).
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FCM_VAPID_KEY=
