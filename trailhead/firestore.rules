rules_version = '2';

// Access model: troops/{t}/access/{uid} is written only by the server. It holds
// { memberId, roles: [...], scoutIds: [...], yptExpiresAt }. Roles: leader, advancement,
// counselor, parent, scout, committee. scoutIds = the Scouts this login acts for
// (a Scout's own id, or a parent's children).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isMember(t) { return signedIn() && exists(/databases/$(database)/documents/troops/$(t)/access/$(request.auth.uid)); }
    function access(t) { return get(/databases/$(database)/documents/troops/$(t)/access/$(request.auth.uid)).data; }
    function hasRole(t, role) { return isMember(t) && role in access(t).roles; }
    function isLeader(t) { return hasRole(t, 'leader') || hasRole(t, 'advancement'); }
    function actsFor(t, scoutId) { return isMember(t) && scoutId in access(t).scoutIds; }
    function canSeeScout(t, scoutId) { return isLeader(t) || actsFor(t, scoutId); }
    function yptCurrent(t) { return access(t).yptExpiresAt > request.time; }
    function card(t, cardId) { return get(/databases/$(database)/documents/troops/$(t)/blueCards/$(cardId)).data; }
    function isCounselorFor(t, cardId) {
      return hasRole(t, 'counselor')
        && exists(/databases/$(database)/documents/troops/$(t)/blueCards/$(cardId))
        && card(t, cardId).counselorUid == request.auth.uid;
    }

    // Shared program content: anyone signed in reads; only admins write.
    match /awards/{awardId}/{rest=**} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /awards/{awardId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /pathTemplates/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    // Published troop websites: anyone may read them; only the publish_site function writes them.
    match /publicSites/{slug} {
      allow read: if true;
      allow write: if false;
    }
    // Which troop owns each website address. Server-only, never readable by clients.
    match /slugs/{slug} {
      allow read, write: if false;
    }
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /troops/{t} {
      allow read: if isMember(t);
      allow write: if false;

      // Invite codes are secrets: only leaders list them, and only the server creates or redeems them.
      match /invites/{code} {
        allow read: if isLeader(t);
        allow write: if false;
      }
      match /access/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || isLeader(t));
        allow write: if false;
      }
      // Roster: names, roles, patrols. Shared with the whole troop.
      // mediaConsent (may photos of this Scout go on the public website) is written only by the
      // set_media_consent function, which checks the caller is a parent or a leader.
      match /members/{m} {
        allow read: if isMember(t);
        allow create: if isLeader(t) && !('mediaConsent' in request.resource.data);
        allow update: if isLeader(t)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['mediaConsent']);
        allow delete: if false;
      }
      // Private Scout details (birth month and year, rank dates). Only the remove_scout function deletes one.
      match /scoutRecords/{s} {
        allow read: if canSeeScout(t, s);
        allow create, update: if isLeader(t);
        allow delete: if false;
      }
      // Parental consent for a Scout: who agreed to which notice version and when, a leader's confirmation
      // for a Scout who may be under 13, and a parent's withdrawal. Leaders and the Scout's family read it;
      // only the server writes it.
      match /consents/{s} {
        allow read: if canSeeScout(t, s);
        allow write: if false;
      }
      // Progress id = {scoutId}_{awardId}, the same id as the Scout's blue card for that badge.
      match /progress/{p} {
        allow read: if canSeeScout(t, resource.data.scoutId) || isCounselorFor(t, p);
        allow write: if false;
      }
      // Signatures are append-only. The server validates and applies them to progress.
      match /signoffs/{id} {
        allow read: if canSeeScout(t, resource.data.scoutId) || resource.data.signerUid == request.auth.uid;
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['scoutId', 'awardId', 'versionId', 'reqId', 'signerUid',
                                                   'signedAt', 'deviceId', 'offline', 'supersedesId', 'status', 'onBehalfOf'])
          && request.resource.data.signerUid == request.auth.uid
          && (!('onBehalfOf' in request.resource.data)
              || (isLeader(t) && request.resource.data.onBehalfOf is string
                  && request.resource.data.onBehalfOf.size() > 0 && request.resource.data.onBehalfOf.size() <= 80))
          && request.resource.data.status == 'pending'
          && yptCurrent(t)
          && (isLeader(t)
              || (isCounselorFor(t, request.resource.data.scoutId + '_' + request.resource.data.awardId)
                  && card(t, request.resource.data.scoutId + '_' + request.resource.data.awardId).status
                     in ['counselor_assigned', 'in_progress']));
        allow update, delete: if false;
      }
      // One path per Scout, stored under the Scout's id. The family and leaders edit it; only the
      // server writes feasibility.
      match /paths/{scoutId} {
        allow read, delete: if canSeeScout(t, scoutId);
        allow create: if canSeeScout(t, scoutId)
          && request.resource.data.scoutId == scoutId
          && !('feasibility' in request.resource.data);
        allow update: if canSeeScout(t, scoutId)
          && request.resource.data.scoutId == scoutId
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['feasibility']);
      }
      // Troop path templates. Leaders write; everyone in the troop reads. Templates are archived, never deleted.
      match /pathTemplates/{id} {
        allow read: if isMember(t);
        allow create, update: if isLeader(t) && validTemplate(request.resource.data);
        allow delete: if false;

        function validTemplate(d) {
          return d.keys().hasOnly(['name', 'description', 'goalAwardId', 'items', 'createdByMemberId', 'updatedAt', 'archived'])
            && d.keys().hasAll(['name', 'description', 'goalAwardId', 'items', 'createdByMemberId', 'updatedAt', 'archived'])
            && d.name is string && d.name.size() > 0 && d.name.size() <= 120
            && d.description is string && d.description.size() <= 1000
            && d.goalAwardId is string
            && d.items is list && d.items.size() <= 200
            && d.createdByMemberId is string
            && d.updatedAt is timestamp
            && d.archived is bool;
        }
      }
      // Blue card id = {scoutId}_{awardId}.
      // requested -> approved -> counselor_assigned -> in_progress -> complete; leaders may cancel.
      // The counselor is either a troop member (counselorUid) or someone outside the troop (counselorName, and
      // counselorEmail when known). For an outside counselor a leader signs and completes the card. Leaders may
      // also change photoPaths (photos of the paper card) alone, in any status.
      match /blueCards/{id} {
        allow read: if canSeeScout(t, resource.data.scoutId) || resource.data.counselorUid == request.auth.uid;
        allow create: if (actsFor(t, request.resource.data.scoutId) || isLeader(t))
          && id == request.resource.data.scoutId + '_' + request.resource.data.awardId
          && request.resource.data.keys().hasOnly(['scoutId', 'awardId', 'versionId', 'status', 'requestedAt'])
          && request.resource.data.status == 'requested';
        allow update: if (isLeader(t) && (leaderTransition() || photosOnly()))
          || (resource.data.counselorUid == request.auth.uid && counselorTransition());
        allow delete: if false;

        function unchanged(keys) { return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys); }
        function photosOnly() {
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photoPaths'])
            && request.resource.data.photoPaths is list
            && request.resource.data.photoPaths.size() <= 20;
        }
        function hasOutsideCounselor(d) {
          return d.get('counselorName', null) is string && !('counselorUid' in d);
        }
        function leaderTransition() {
          let from = resource.data.status;
          let to = request.resource.data.status;
          let uid = request.resource.data.get('counselorUid', null);
          let name = request.resource.data.get('counselorName', null);
          return unchanged(['scoutId', 'awardId', 'versionId', 'source', 'recordedAt'])
            && ((from == 'requested' && to == 'approved')
              || (from in ['approved', 'counselor_assigned'] && to == 'counselor_assigned'
                  && ((uid is string && !(name is string)) || (name is string && !(uid is string))))
              || (from in ['counselor_assigned', 'in_progress'] && to == 'complete'
                  && hasOutsideCounselor(resource.data) && hasOutsideCounselor(request.resource.data))
              || (from != 'complete' && to == 'cancelled'));
        }
        function counselorTransition() {
          let from = resource.data.status;
          let to = request.resource.data.status;
          return unchanged(['scoutId', 'awardId', 'versionId', 'counselorUid', 'counselorName', 'counselorEmail',
                            'photoPaths', 'source', 'recordedAt'])
            && ((from == 'counselor_assigned' && to == 'in_progress')
              || (from == 'in_progress' && to == 'complete'));
        }
      }
      // Troop-made awards and their requirement versions. Only the server writes them, so every edit
      // is validated and creates a new version instead of changing requirements Scouts already started.
      match /customAwards/{awardId} {
        allow read: if isMember(t);
        allow write: if false;
        match /versions/{versionId} {
          allow read: if isMember(t);
          allow write: if false;
        }
      }
      match /counselors/{c} {
        allow read: if isMember(t);
        allow write: if isLeader(t);
      }
      match /events/{e} {
        allow read: if isMember(t);
        allow write: if isLeader(t);
        match /rsvps/{memberId} {
          allow read: if isMember(t);
          allow write: if isLeader(t) || actsFor(t, memberId) || access(t).memberId == memberId;
        }
        match /attendance/{memberId} {
          allow read: if isMember(t);
          allow write: if isLeader(t);
        }
      }
      match /logs/{id} {
        allow read: if canSeeScout(t, resource.data.scoutId);
        allow write: if false;
      }
      // Messages are only created by the send_message function, which applies Youth Protection rules.
      match /threads/{th} {
        allow read: if signedIn() && request.auth.uid in resource.data.participantUids;
        allow write: if false;
        match /messages/{m} {
          allow read: if signedIn()
            && request.auth.uid in get(/databases/$(database)/documents/troops/$(t)/threads/$(th)).data.participantUids;
          allow write: if false;
        }
      }
      // The troop website draft. Leaders edit it here; only the publish_site function makes a public copy.
      match /site/draft {
        allow read, delete: if isLeader(t);
        allow create, update: if isLeader(t) && validSiteDraft(request.resource.data);

        function absent(d, k) { return !(k in d) || d[k] == null; }
        function text(d, k, max) { return absent(d, k) || (d[k] is string && d[k].size() <= max); }
        function items(d, k, max) { return absent(d, k) || (d[k] is list && d[k].size() <= max); }
        function section(d, k) { return absent(d, k) || (d[k] is map && d[k].size() <= 5); }
        function validSiteDraft(d) {
          return d.keys().hasOnly(['slug', 'theme', 'cover', 'about', 'meeting', 'faq', 'contacts', 'gallery',
                                   'recruiting', 'updatedAt'])
            && text(d, 'slug', 40)
            && text(d, 'about', 4000)
            && section(d, 'theme') && section(d, 'cover') && section(d, 'meeting') && section(d, 'recruiting')
            && items(d, 'faq', 20)
            && items(d, 'contacts', 6)
            && items(d, 'gallery', 24);
        }
      }
      // What the live site shows (which Scouts each public photo includes). Server-only.
      match /site/published {
        allow read: if isLeader(t);
        allow write: if false;
      }
      // Draft counters for the plan assistant. Server-only; clients never read or write them.
      match /usage/{u} {
        allow read, write: if false;
      }
      // Families who asked about the troop through its public page. The submit_interest function
      // creates them; leaders may only change the status and their own notes.
      match /leads/{id} {
        allow read: if isLeader(t);
        allow create, delete: if false;
        allow update: if isLeader(t)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'notes'])
          && request.resource.data.status in ['new', 'contacted', 'invited', 'joined', 'not_interested']
          && request.resource.data.notes is string
          && request.resource.data.notes.size() <= 2000;
      }
      match /exports/{x} {
        allow read: if isLeader(t);
        allow write: if false;
      }
    }
  }
}
